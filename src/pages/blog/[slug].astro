---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { BlogPostApp } from "../../components/pages/BlogPages";
import { getBlogPosts, summarize, type BlogPost } from "../../data/blog";
import { dictionary } from "../../data/i18n";

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const summary = summarize(post);

// Each language shows its own version, or falls back to the other one with
// a short notice.
const enEntry = post.entries.en ?? post.entries.es!;
const esEntry = post.entries.es ?? post.entries.en!;
const { Content: EnContent } = await render(enEntry);
const { Content: EsContent } = await render(esEntry);
const enFallback = !post.entries.en;
const esFallback = !post.entries.es;

const postUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/blog/${post.slug}/`, Astro.site).toString();
const articleLd = {
	"@context": "https://schema.org",
	"@type": post.primary.data.type === "talk" ? "Event" : "BlogPosting",
	...(post.primary.data.type === "talk"
		? { name: enEntry.data.title, startDate: post.primary.data.date.toISOString(), description: enEntry.data.description }
		: {
				headline: enEntry.data.title,
				description: enEntry.data.description,
				datePublished: post.primary.data.date.toISOString(),
				inLanguage: Object.keys(post.entries),
			}),
	url: postUrl,
	author: { "@type": "Person", name: "Paco Molina", url: new URL("/", Astro.site).toString() },
};
---

<Layout
	title={`${enEntry.data.title} — Paco Molina`}
	description={enEntry.data.description}
	ogType="article"
	jsonLd={articleLd}
>
	<BlogPostApp client:load post={summary}>
		<div data-lang="en" lang={enFallback ? "es" : "en"}>
			{enFallback && <p><em>{dictionary.en.pages.blog.onlyIn}</em></p>}
			<EnContent />
		</div>
		<div data-lang="es" lang={esFallback ? "en" : "es"}>
			{esFallback && <p><em>{dictionary.es.pages.blog.onlyIn}</em></p>}
			<EsContent />
		</div>
	</BlogPostApp>
</Layout>
