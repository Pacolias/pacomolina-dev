---
import "../styles/global.css";
import { dictionary } from "../data/i18n";
import { site } from "../data/site";
import { getBlogPosts, summarize } from "../data/blog";

interface Props {
	// Per-page title/description (English — the prerendered language). Home
	// omits them and falls back to the site-wide meta.
	title?: string;
	description?: string;
	ogType?: "website" | "article";
	// Pages that shouldn't be indexed (the 404): no canonical, robots noindex.
	noindex?: boolean;
	// Extra structured data for this page (e.g. a blog post's BlogPosting),
	// alongside the site-wide Person block.
	jsonLd?: Record<string, unknown>;
	// Social preview card (root-relative path in public/). Sections have
	// their own under public/og/ (see scripts/og/render.mjs).
	ogImage?: string;
}

const meta = dictionary.en.meta;
const {
	title = meta.title,
	description = meta.description,
	ogType = "website",
	noindex = false,
	jsonLd,
	ogImage: ogImagePath = "/og-image.jpg",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(`${base}${ogImagePath}`, Astro.site).toString();
const personImage = new URL(`${base}/og-image.jpg`, Astro.site).toString();
// Blog summaries for the swipe preview of the blog index (BlogIndexPreview),
// which neighbouring pages render without having the posts as a prop.
const blogIndex = (await getBlogPosts()).map(summarize);
const homeUrl = new URL(`${base}/`, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const personLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: dictionary.en.hero.role,
	url: homeUrl,
	image: personImage,
	email: `mailto:${site.email}`,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Málaga",
		addressCountry: "ES",
	},
	sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!--
			Cross-page fade opt-in, inline and first in <head>: it has to be in
			place the moment the next page decides whether to accept the
			transition; from the bundled stylesheet (end of <head>) Chrome
			often missed it and skipped the fade on slower phones. The fade's
			timing lives in global.css.
		-->
		<style is:inline>
			@view-transition {
				navigation: auto;
			}
			/* After a swipe between sections (useSwipeNavigation) the next page
			   is already on screen as the swipe preview, so the transition only
			   settles into the real page with a very short fade. Inline too, so
			   the CSS pipeline never touches this newer selector. */
			html:active-view-transition-type(swipe-commit)::view-transition-old(root),
			html:active-view-transition-type(swipe-commit)::view-transition-new(root) {
				animation-duration: 0.12s;
			}
			@media (prefers-reduced-motion: reduce) {
				@view-transition {
					navigation: none;
				}
			}
		</style>
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}/manifest.webmanifest`} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
		<meta name="theme-color" content="#fdba74" id="theme-color-meta" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Paco Molina — Blog"
			href={new URL(`${base}/rss.xml`, Astro.site).toString()}
		/>

		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("lang");
					var lang =
						stored === "en" || stored === "es"
							? stored
							: (navigator.language || "en").toLowerCase().startsWith("es")
								? "es"
								: "en";
					window.__INITIAL_LANG__ = lang;
					document.documentElement.lang = lang;
					if (lang !== "en") {
						// Hide the English prerender until React swaps it (see
						// global.css); never stay hidden if hydration fails.
						var root = document.documentElement;
						root.setAttribute("data-lang-pending", "");
						setTimeout(function () {
							root.removeAttribute("data-lang-pending");
						}, 1500);
					}
				} catch (e) {
					window.__INITIAL_LANG__ = "en";
				}
			})();
		</script>

		<script is:inline>
			// Page-to-page cross-fade for non-English visitors: the new page is
			// still hidden while React swaps in their language, so fading to it
			// right away would fade into an empty page. Instead, pause the view
			// transition on its first frame (the old page, fully visible) and
			// play it once LanguageProvider fires "lang-ready" — capped at 1s so
			// a JS failure can't leave it stuck.
			// Arrived by swiping? Tag the transition so the slide rules in the
			// inline <style> above apply (plain cross-fade otherwise).
			window.addEventListener("pagereveal", function (event) {
				var direction = null;
				try {
					direction = sessionStorage.getItem("swipe-nav");
					sessionStorage.removeItem("swipe-nav");
				} catch (e) {}
				var transition = event.viewTransition;
				if (transition && transition.types && direction) {
					transition.types.add("swipe-" + direction);
				}
			});

			window.addEventListener("pagereveal", function (event) {
				var transition = event.viewTransition;
				var root = document.documentElement;
				if (!transition || !root.hasAttribute("data-lang-pending")) return;
				transition.ready.then(function () {
					if (!root.hasAttribute("data-lang-pending")) return;
					var animations = document.getAnimations().filter(function (a) {
						var pseudo = a.effect && a.effect.pseudoElement;
						return pseudo && pseudo.indexOf("::view-transition") === 0;
					});
					animations.forEach(function (a) {
						a.pause();
					});
					var resume = function () {
						animations.forEach(function (a) {
							a.play();
						});
					};
					window.addEventListener("lang-ready", resume, { once: true });
					setTimeout(resume, 1000);
				});
			});
		</script>

		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme");
					var theme =
						stored === "light" || stored === "dark"
							? stored
							: window.matchMedia &&
								  window.matchMedia("(prefers-color-scheme: dark)").matches
								? "dark"
								: "light";
					window.__INITIAL_THEME__ = theme;
					document.documentElement.classList.toggle("dark", theme === "dark");
					var metaTheme = document.getElementById("theme-color-meta");
					if (metaTheme) {
						metaTheme.setAttribute(
							"content",
							theme === "dark" ? "#0c0a09" : "#fdba74"
						);
					}
				} catch (e) {
					window.__INITIAL_THEME__ = "light";
				}
			})();
		</script>

		<script is:inline>
			// The fade-up intro only plays on the first page of a visit; later
			// navigations rely on the view transition (see global.css).
			(function () {
				try {
					if (sessionStorage.getItem("intro-seen")) {
						document.documentElement.classList.add("no-intro");
					} else {
						sessionStorage.setItem("intro-seen", "1");
					}
				} catch (e) {}
			})();
		</script>

		{
			/* Analytics: only in production builds, only once a GoatCounter
			   code is set in site.ts (so local visits are never counted). */
			import.meta.env.PROD && site.goatcounter && (
				<script
					is:inline
					async
					data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}
					src="https://gc.zgo.at/count.js"
				/>
			)
		}
	</head>
	<body class="bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200">
		<slot />
		<script type="application/json" id="blog-index" set:html={JSON.stringify(blogIndex)} />
	</body>
</html>
